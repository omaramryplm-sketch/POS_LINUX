COMPOSE_PROJECT_NAME=pos_master
VIRTUAL_HOST=pos.192.168.10.127.nip.io,master.192.168.10.127.nip.io
# JWT_SECRET: Clave criptográfica fuerte de al menos 32 caracteres (generar con `openssl rand -hex 32`)
JWT_SECRET=reemplazar_con_clave_criptografica_fuerte_de_al_menos_32_caracteres
# ALLOWED_ORIGINS: Orígenes permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:8080,http://192.168.10.127:8080,http://pos.192.168.10.127.nip.io,http://master.192.168.10.127.nip.io
